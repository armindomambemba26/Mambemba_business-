rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function teamDoc() {
      return get(/databases/$(database)/documents/team/$(request.auth.uid)).data;
    }
    function isActiveMember() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/team/$(request.auth.uid))
        && teamDoc().estado == 'Ativo';
    }
    function isAdminOrManager() {
      return isActiveMember() && (teamDoc().funcao == 'Admin' || teamDoc().funcao == 'Gestor');
    }

    // Perfis da equipa: qualquer pessoa autenticada pode sempre ler o seu
    // PRÓPRIO perfil (necessário para o login validar o estado/função —
    // mesmo antes de saber se está ativa), mas só pode ler o perfil de
    // OUTRAS pessoas se for ela própria um membro ativo. Só Admin/Gestor
    // pode criar, editar ou remover perfis.
    match /team/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isActiveMember());
      allow create, update, delete: if isAdminOrManager();
    }

    // Encomendas, clientes, definições e financeiro: só equipa ativa.
    match /app_data/{docId} {
      allow read, write: if isActiveMember();
    }

    // Fotos dos produtos (guardadas como base64, já que o Storage exige
    // o plano pago Blaze). Documentos pequenos (poucas centenas de KB,
    // comprimidos no cliente antes de guardar).
    match /photos/{orderId} {
      allow read, write: if isActiveMember();
    }

    // Resumo público do recibo (sem nome, contacto ou endereço do cliente),
    // usado só para a validação por QR Code funcionar sem sessão iniciada.
    // Só a equipa pode criar/editar; qualquer pessoa pode ler.
    match /receipts/{orderId} {
      allow read: if true;
      allow write: if isActiveMember();
    }
  }
}
