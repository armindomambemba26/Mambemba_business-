rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /photos/{fileName} {
      allow read, write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/team/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/team/$(request.auth.uid)).data.estado == 'Ativo';
    }
  }
}
